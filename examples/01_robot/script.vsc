filltriangle bird_beak, 1056, 220, 1062, 217, 1062, 223, #e6a020, z, 2
filltriangle bird_wl, 1062, 216, 1052, 210, 1062, 224, #555555, z, 2
filltriangle bird_wr, 1078, 216, 1088, 210, 1078, 224, #555555, z, 2
