settings 1280 720

# Робот-андроид: голова, торс, руки, ноги (координаты относительно центра, ноги внизу)
character robot:
# Ноги
fillroundrect thigh_l, -22, -70, 12, 38, 6, #00aaff
fillroundrect thigh_r, 10, -70, 12, 38, 6, #00aaff
fillroundrect shin_l, -22, -34, 12, 36, 6, #00aaff
fillroundrect shin_r, 10, -34, 12, 36, 6, #00aaff
fillroundrect foot_l, -26, -10, 18, 10, 4, #0088cc
fillroundrect foot_r, 8, -10, 18, 10, 4, #0088cc
# Торс
fillroundrect body, -32, -108, 64, 40, 10, #00aaff
# Руки (плечо + предплечье + кисть)
fillroundrect arm_upper_l, -46, -98, 14, 32, 7, #00aaff
fillroundrect arm_upper_r, 32, -98, 14, 32, 7, #00aaff
fillroundrect arm_lower_l, -48, -68, 12, 28, 6, #00aaff
fillroundrect arm_lower_r, 46, -68, 12, 28, 6, #00aaff
fillcircle hand_l, -46, -52, 8, #eeeeee
fillcircle hand_r, 52, -52, 8, #eeeeee
# Голова
fillcircle head, 0, -128, 20, #eeeeee
circle head_outline, 0, -128, 20, #aaaaaa, 1
fillcircle eye1, -7, -132, 7, #1a1a1a
fillcircle eye2, 7, -132, 7, #1a1a1a
fillcircle eye1_hi, -5, -134, 2, #ffffff
fillcircle eye2_hi, 9, -134, 2, #ffffff
fillcircle nose, 0, -124, 3, #cc0000
line mouth, -6, -118, 6, -118, #00aa00, 2
# Антенна (как у андроида)
line antenna, 0, -148, 0, -158, #333333, 2
fillcircle antenna_cap, 0, -162, 5, #00aaff
end

# Фон: порядок отрисовки задаётся параметром z (меньше — дальше, больше — ближе)
frame 0:
fillrect sky, 0, 0, 1280, 720, #87ceeb, z, -3
fillcircle sun, 1100, 120, 70, #ffec80, z, -2
fillcircle sun_core, 1100, 120, 55, #ffdd00, z, -2
fillrect grass, 0, 480, 1280, 170, #3cb371, z, -1
fillroundrect tree_trunk, 180, 380, 45, 100, 8, #8b4513, z, 0
fillcircle tree_foliage1, 202, 320, 75, #228b22, z, 0
fillcircle tree_foliage2, 165, 350, 55, #2e8b57, z, 0
fillcircle tree_foliage3, 240, 340, 60, #228b22, z, 0

# Земля и помидоры (ряд внизу экрана)
frame 0:
fillrect ground, 0, 650, 1280, 70, #553322, z, 1
fillcircle t1, 200, 600, 30, #cc2222, z, 2
fillcircle t2, 400, 600, 30, #cc2222, z, 2
fillcircle t3, 600, 600, 30, #cc2222, z, 2
fillcircle t4, 800, 600, 30, #cc2222, z, 2
fillcircle t5, 1000, 600, 30, #cc2222, z, 2

# Птица: летит справа налево, крылья машут
frame 0:
fillcircle bird_body, 1310, 220, 7, #333333, z, 2
filltriangle bird_beak, 1296, 220, 1302, 217, 1302, 223, #e6a020, z, 2
filltriangle bird_wl, 1302, 216, 1292, 210, 1302, 224, #555555, z, 2
filltriangle bird_wr, 1318, 216, 1328, 210, 1318, 224, #555555, z, 2

# Робот r — ноги на верхней границе помидора
frame 0:
char robot r, 200, 570, z, 2

# t1 исчезает после приземления. Птица — крылья вниз.
frame 25:
fillcircle bird_body, 1190, 220, 7, #333333, z, 2
filltriangle bird_beak, 1176, 220, 1182, 217, 1182, 223, #e6a020, z, 2
filltriangle bird_wl, 1182, 224, 1172, 230, 1182, 216, #555555, z, 2
filltriangle bird_wr, 1198, 224, 1208, 230, 1198, 216, #555555, z, 2
char robot r, 300, 550, z, 2
fillcircle t1, 200, 600, 0, #cc2222, z, 2

# На помидоре 2. Птица — крылья вверх.
